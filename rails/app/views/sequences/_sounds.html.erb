<details class="group sounds" data-controller="sound-preview">
  <summary>Sounds</summary>

  <div class="row">
    <label for="sound_countdown">Countdown</label>
    <span class="row-control">
      <%= select_tag "sequence[sound][countdown]", options_for_select(SoundSettings::COUNTDOWNS.invert, sound["countdown"]),
            id: "sound_countdown", class: "input", data: { action: "sound-preview#tick" } %>
      <button type="button" class="link-button" data-action="sound-preview#tick">Play tick</button>
    </span>
  </div>

  <% [ [ "Interval ends", "intervalEnd" ], [ "Round ends", "roundEnd" ], [ "Sequence done", "finish" ] ].each do |label, key| %>
    <div class="row">
      <label for="sound_<%= key %>"><%= label %></label>
      <%= select_tag "sequence[sound][#{key}]", options_for_select(SoundSettings::CHOICES.invert, sound[key]),
            id: "sound_#{key}", class: "input", data: { action: "sound-preview#choice", sound_preview_target: (key == "intervalEnd" ? "intervalEnd" : nil) } %>
    </div>
  <% end %>
  <p class="footer-note">When two sounds fall at the same moment, the bigger event wins: done, then round, then interval. If a sound is None, the next one down plays.</p>

  <div class="row">
    <label for="sound_breathing">Breathing guide</label>
    <%= hidden_field_tag "sequence[sound][breathingGuide]", "0", id: nil %>
    <%= check_box_tag "sequence[sound][breathingGuide]", "1", sound["breathingGuide"], id: "sound_breathing", class: "toggle" %>
  </div>
  <div class="breath-previews">
    <button type="button" class="secondary-button" data-action="sound-preview#breath" data-sound-preview-role-param="inhale">Play inhale</button>
    <button type="button" class="secondary-button" data-action="sound-preview#breath" data-sound-preview-role-param="hold">Play hold</button>
    <button type="button" class="secondary-button" data-action="sound-preview#breath" data-sound-preview-role-param="exhale">Play exhale</button>
  </div>

  <div class="row">
    <label for="sound_volume">Volume</label>
    <%= range_field_tag "sequence[sound][volume]", sound["volume"], min: 0, max: 1, step: 0.05, id: "sound_volume",
          data: { sound_preview_target: "volume", action: "change->sound-preview#volume" } %>
  </div>

  <div class="row">
    <label for="sound_haptics">Vibrate on each interval</label>
    <%= hidden_field_tag "sequence[sound][haptics]", "0", id: nil %>
    <%= check_box_tag "sequence[sound][haptics]", "1", sound["haptics"], id: "sound_haptics", class: "toggle" %>
  </div>
</details>
